@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
include("${CMAKE_CURRENT_LIST_DIR}/Sunfleck.MsvcDependencies.cmake")
find_dependency(Threads)
if("@CMAKE_SYSTEM_NAME@" STREQUAL "Linux")
  if("@UI_ATSPI_FOUND@")
    find_dependency(PkgConfig)
    pkg_check_modules(UI_ATSPI REQUIRED IMPORTED_TARGET atk-bridge-2.0 atk gobject-2.0 glib-2.0)
  endif()
  if("@Freetype_FOUND@")
    find_dependency(Freetype)
  endif()
  if("@UI_PLATFORM_X11@")
    find_dependency(X11)
  endif()
endif()
if("@UI_ENABLE_SKIA_D3D12@" AND NOT TARGET Sunfleck::Skia)
  add_library(Sunfleck::Skia STATIC IMPORTED)
  set_target_properties(Sunfleck::Skia PROPERTIES
    IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/sunfleck/skia/skia.lib"
    INTERFACE_LINK_LIBRARIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/sunfleck/skia/skcms.lib;${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/sunfleck/skia/d3d12allocator.lib;${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/sunfleck/skia/spirv_cross.lib;d3d12;dxgi;d3dcompiler;fontsub;usp10;ole32")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/SunfleckTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/Sunfleck.Development.cmake")
if("@EMSCRIPTEN@")
  set_and_check(Sunfleck_WEB_ASSETS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/sunfleck/web")
endif()
check_required_components(Sunfleck)
