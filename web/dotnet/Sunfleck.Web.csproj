<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WasmBuildNative>true</WasmBuildNative>
    <!-- The core and host must use the same exception-handling ABI. -->
    <WasmEnableExceptionHandling>true</WasmEnableExceptionHandling>
    <WasmEnableThreads>false</WasmEnableThreads>
    <EmccExtraLDFlags>$(EmccExtraLDFlags) -sUSE_FREETYPE=1 -sUSE_HARFBUZZ=1 -lc++ -lc++abi</EmccExtraLDFlags>
    <SunfleckNativeLibrary Condition="'$(SunfleckNativeLibrary)' == ''">../../out/web-dotnet-native/sunfleck_native.a</SunfleckNativeLibrary>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../bindings/csharp/Sunfleck.csproj" />
    <NativeFileReference Include="$(SunfleckNativeLibrary)" />
    <Content Include="main.js" Link="wwwroot/main.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../web/index.html" Link="wwwroot/index.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../web/host.js" Link="wwwroot/host.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../web/renderer.js" Link="wwwroot/renderer.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../web/text-input.js" Link="wwwroot/text-input.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../web/workspace.fleck" Link="wwwroot/workspace.fleck" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../web/message.txt" Link="wwwroot/message.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(SunfleckWebFont)" Link="wwwroot/font.ttf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(SunfleckBidiLicense)" Condition="Exists('$(SunfleckBidiLicense)')" Link="wwwroot/SheenBidi-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckSunfleckWebInputs" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(SunfleckNativeLibrary)')" Text="Build the core with the .NET Emscripten toolchain first; see docs/web.md." />
    <Error Condition="!Exists('$(SunfleckWebFont)')" Text="Set SunfleckWebFont to a licensed TTF/OTF file." />
  </Target>
</Project>
