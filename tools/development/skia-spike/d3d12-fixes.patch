diff --git a/src/gpu/ganesh/d3d/GrD3DTextureResource.cpp b/src/gpu/ganesh/d3d/GrD3DTextureResource.cpp
index 4c9569b..f437a1e 100644
--- a/src/gpu/ganesh/d3d/GrD3DTextureResource.cpp
+++ b/src/gpu/ganesh/d3d/GrD3DTextureResource.cpp
@@ -50,6 +50,31 @@ bool GrD3DTextureResource::InitTextureResourceInfo(GrD3DGpu* gpu, const D3D12_RE
         return false;
     }
 
+    // Placed RT/DS resources require an initializing operation before any draw or resolve.
+    // Initialize every new owned allocation, including scratch targets whose first pass loads.
+    // Wrapped resources never enter this path, and existing contents are never discarded here.
+    if (desc.Flags & (D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET |
+                      D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL)) {
+        sk_sp<Resource> resource(new Resource(info->fResource, info->fAlloc));
+        const D3D12_RESOURCE_STATES discardState =
+                (desc.Flags & D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL)
+                        ? D3D12_RESOURCE_STATE_DEPTH_WRITE : D3D12_RESOURCE_STATE_RENDER_TARGET;
+        D3D12_RESOURCE_TRANSITION_BARRIER barrier = {};
+        barrier.pResource = info->fResource.get();
+        barrier.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+        barrier.StateBefore = initialState;
+        barrier.StateAfter = discardState;
+        if (initialState != discardState) {
+            gpu->addResourceBarriers(resource, 1, &barrier);
+        }
+        gpu->currentCommandList()->discardResource(resource, info->fResource.get());
+        if (initialState != discardState) {
+            barrier.StateBefore = discardState;
+            barrier.StateAfter = initialState;
+            gpu->addResourceBarriers(resource, 1, &barrier);
+        }
+    }
+
     info->fResourceState = initialState;
     info->fFormat = desc.Format;
     info->fLevelCount = desc.MipLevels;
