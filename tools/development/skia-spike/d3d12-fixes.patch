+void GrD3DDirectCommandList::discardResource(sk_sp<GrManagedResource> managedResource,
+                                          ID3D12Resource* resource) {
+    // Flush transitions before DiscardResource, and retain the allocation until completion.
+    this->addingWork();
+    this->addResource(std::move(managedResource));
+    fCommandList->DiscardResource(resource, nullptr);
+}
